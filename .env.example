# ── Local dev (npm run dev) ─────────────────────────────────────────────
VITE_APP_NAME=MyChatApp

# Vite proxy target khi VITE_API_BASE_URL để trống
VITE_DEV_API_TARGET=http://localhost:8080

# Để trống → /api và /ws đi qua proxy (cùng origin localhost:3000)
# VITE_API_BASE_URL=
# VITE_WS_BASE_URL=

# Test trực tiếp API trên EC2/domain (không dùng proxy):
# VITE_API_BASE_URL=https://chatapi.oeb20412.com
# VITE_WS_BASE_URL=https://chatapi.oeb20412.com

# ── Production (Vercel: Settings → Environment Variables) ───────────────
# Cloudflare Proxied + HTTPS (khuyến nghị):
# VITE_API_BASE_URL=https://chatapi.oeb20412.com
# VITE_WS_BASE_URL=https://chatapi.oeb20412.com
#
# DNS only, gateway port 8080:
# VITE_API_BASE_URL=http://chatapi.oeb20412.com:8080
# VITE_WS_BASE_URL=http://chatapi.oeb20412.com:8080
